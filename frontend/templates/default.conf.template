# Wird beim Start per envsubst zu /etc/nginx/conf.d/default.conf (setzt ${HTTPS_PORT} und ${HTTPS_REDIRECT} ein).
# Die eigentliche Auslieferung (Anwendung, /api-Proxy, Header) steht in /etc/nginx/snippets/sophosstats.conf.

# Schema für das Backend: hinter einem vorgeschalteten Reverse Proxy dessen X-Forwarded-Proto übernehmen
map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# Weiterleitung auf HTTPS (1) oder nicht (0). Entfällt, wenn
#  - HTTPS_REDIRECT=false gesetzt ist, oder
#  - die Anfrage schon per HTTPS über einen vorgeschalteten Reverse Proxy kam (X-Forwarded-Proto: https).
map "${HTTPS_REDIRECT}:$http_x_forwarded_proto" $https_redirect {
    default     1;
    "~*^false:" 0;
    "~*:https$" 0;
}

server {
    listen 80;
    server_name _;

    if ($https_redirect) {
        return 301 https://$host:${HTTPS_PORT}$request_uri;
    }

    include /etc/nginx/snippets/sophosstats.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    include /etc/nginx/snippets/sophosstats.conf;
}
