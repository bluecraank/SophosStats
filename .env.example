# Kopieren nach .env und Werte setzen.

# Datenbank-Passwort (beliebig, lang)
POSTGRES_PASSWORD=bitte-aendern

# Schlüssel für die Verschlüsselung der Firewall-Zugangsdaten und TOTP-Secrets.
# Erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NICHT verlieren – ohne ihn sind gespeicherte Zugangsdaten unbrauchbar.
ENCRYPTION_KEY=

# Erster Administrator (wird nur angelegt, solange noch kein Benutzer existiert)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Sitzungsdauer in Stunden
SESSION_TTL_HOURS=12

# Ports der Weboberfläche auf dem Host (z.B. 8443, falls 443 belegt ist)
HTTP_PORT=80
HTTPS_PORT=443
# Adresse, an die die Web-Ports gebunden werden. 127.0.0.1 = nur vom Docker-Host erreichbar (Reverse Proxy auf
# demselben Host). Achtung: von Docker veröffentlichte Ports umgehen ufw, eine ufw-Regel sperrt sie nicht.
WEB_BIND=0.0.0.0
# Weiterleitung HTTP->HTTPS. Entfällt automatisch, wenn ein Reverse Proxy davor "X-Forwarded-Proto: https"
# mitschickt; false = nie weiterleiten (Proxy ohne diesen Header oder bewusst reines HTTP)
HTTPS_REDIRECT=true

# Aufbewahrung in Tagen
RETENTION_METRICS_DAYS=90
RETENTION_LOGS_DAYS=30
RETENTION_RULE_USAGE_DAYS=400
# Verdichtete abgelehnte Verbindungen (Bericht, Standortübergreifend)
RETENTION_BLOCKED_DAYS=90

# Hostnamen der IPs aus den Logs per Reverse-DNS lernen (Suche "EDV-…", Anzeige unter IPs).
# Nur interne (private) IPs werden nachgeschlagen, solange RDNS_PRIVATE_ONLY=true.
RDNS_ENABLED=true
RDNS_PRIVATE_ONLY=true
